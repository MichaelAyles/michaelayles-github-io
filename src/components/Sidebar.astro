---
import { getCollection } from 'astro:content';
import { cleanSlug } from '../utils';

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sorted = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group chronologically by month
const groups: { label: string; posts: { slug: string; title: string; day: number }[] }[] = [];
for (const post of sorted) {
  const label = post.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
  const entry = {
    slug: cleanSlug(post.id),
    title: post.data.title,
    day: post.data.date.getDate(),
  };
  const last = groups[groups.length - 1];
  if (last && last.label === label) {
    last.posts.push(entry);
  } else {
    groups.push({ label, posts: [entry] });
  }
}
---

<aside class="sidebar">
  <h2 class="sidebar-title">All posts</h2>
  {groups.map(group => (
    <section class="month-group">
      <h3 class="month-label">{group.label}</h3>
      <ul class="month-posts">
        {group.posts.map(post => (
          <li>
            <a
              href={`/blog/${post.slug}/`}
              class:list={['sidebar-link', { current: post.slug === currentSlug }]}
              aria-current={post.slug === currentSlug ? 'page' : undefined}
            >
              <span class="day">{post.day}</span>
              <span class="link-title">{post.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</aside>

<style>
  .sidebar {
    font-size: 0.85rem;
  }

  .sidebar-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .month-group {
    margin-bottom: 1.25rem;
  }

  .month-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
  }

  .month-posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .month-posts li {
    margin-bottom: 0.15rem;
  }

  .sidebar-link {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.2rem 0.4rem;
    margin-left: -0.4rem;
    border-radius: 4px;
    text-decoration: none;
    color: var(--text-secondary);
    line-height: 1.4;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .sidebar-link:hover {
    color: var(--text-primary);
    background: var(--hover-bg);
  }

  .sidebar-link.current {
    color: var(--text-primary);
    font-weight: 600;
    background: var(--hover-bg);
  }

  .day {
    flex-shrink: 0;
    width: 1.2rem;
    text-align: right;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
    opacity: 0.7;
  }

  .link-title {
    flex: 1;
  }
</style>
