---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Footer from '../components/Footer.astro';
import PostList from '../components/PostList.astro';
import Sidebar from '../components/Sidebar.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sorted = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Mike Ayles" description="Blog & Portfolio - Electronics & Embedded Systems Engineer">
  <Nav current="blog"><ThemeToggle /></Nav>

  <main class="main">
    <div class="layout">
      <div class="feed-col">
        <header class="feed-header">
          <h1 class="feed-title">Blog</h1>
          <a href="/rss.xml" class="feed-rss">Subscribe via RSS</a>
        </header>
        <PostList posts={sorted} />
      </div>
      <div class="sidebar-col">
        <Sidebar />
      </div>
    </div>
    <Footer />
  </main>
</BaseLayout>

<style>
  .main {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 660px) 240px;
    justify-content: space-between;
    column-gap: 4rem;
    padding-top: 2.5rem;
    padding-bottom: 2rem;
  }

  .feed-col {
    min-width: 0;
  }

  .feed-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .feed-title {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .feed-rss {
    font-size: 0.8rem;
    color: var(--text-secondary);
    text-decoration: none;
    white-space: nowrap;
  }

  .feed-rss:hover {
    color: var(--text-primary);
    text-decoration: underline;
  }

  .sidebar-col {
    padding-top: 0.4rem;
  }

  @media (max-width: 899px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    /* The feed already lists every post in full, so the archive
       sidebar is pure duplication on narrow screens; hide it. */
    .sidebar-col {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .main {
      padding: 0 1.25rem;
    }
  }
</style>
