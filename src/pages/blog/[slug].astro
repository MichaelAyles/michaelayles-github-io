---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { cleanSlug } from '../../utils';

export async function getStaticPaths() {
  // Build a page for every post, including drafts, so drafts are reachable at
  // their own URL (unlisted preview). Drafts still stay out of the blog index,
  // pagination, and RSS, so they are not "published" anywhere a reader browses.
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: cleanSlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Find related project
const allProjects = await getCollection('projects');
const slug = cleanSlug(post.id);
const relatedProject = allProjects.find(p => p.data.blogPost === slug);

// Adjacent live posts, newest first. Drafts have no index here, so they get no nav.
const livePosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const currentIndex = livePosts.findIndex(p => cleanSlug(p.id) === slug);
const newerPost = currentIndex > 0 ? livePosts[currentIndex - 1] : undefined;
const olderPost = currentIndex >= 0 ? livePosts[currentIndex + 1] : undefined;

// Date/category pill: "NOV 27, 2025 · HARDWARE" (uppercased via CSS)
const pillDate = post.data.date.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
const pillLabel = post.data.tags.length > 0
  ? `${pillDate} · ${post.data.tags[0]}`
  : pillDate;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <Nav current="blog"><ThemeToggle /></Nav>

  <main class="main">
    <article class="article">
      <header class="article-header">
        <span class="article-pill">{pillLabel}</span>
        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-desc">{post.data.description}</p>
        <div class="article-tags">
          {post.data.tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      {relatedProject && (
        <aside class="related-project">
          <h3>Related Project</h3>
          <p class="rp-name">{relatedProject.data.name}</p>
          <p class="rp-desc">{relatedProject.data.description}</p>
          <div class="rp-links">
            {relatedProject.data.links.live && (
              <a href={relatedProject.data.links.live} target="_blank">Live</a>
            )}
            {relatedProject.data.links.github && (
              <a href={relatedProject.data.links.github} target="_blank">Code</a>
            )}
          </div>
        </aside>
      )}

      {(newerPost || olderPost) && (
        <nav class="post-nav" aria-label="Adjacent posts">
          {newerPost ? (
            <a href={`/blog/${cleanSlug(newerPost.id)}/`} class="post-nav-link newer">
              <span class="post-nav-label">&larr; Newer</span>
              <span class="post-nav-title">{newerPost.data.title}</span>
            </a>
          ) : <span />}
          {olderPost && (
            <a href={`/blog/${cleanSlug(olderPost.id)}/`} class="post-nav-link older">
              <span class="post-nav-label">Older &rarr;</span>
              <span class="post-nav-title">{olderPost.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </article>

    <Footer />
  </main>
</BaseLayout>

<style>
  .main {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .article {
    max-width: 620px;
    margin: 0 auto;
    font-size: 1.125rem;
  }

  .article-header {
    margin-bottom: 2.5rem;
  }

  .article-pill {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.66em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--chip-bg);
    border: 1px solid var(--chip-border);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    margin-bottom: 1rem;
  }

  .article-title {
    font-family: var(--font-heading);
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--heading);
    margin: 0 0 1rem;
    text-wrap: pretty;
  }

  .article-desc {
    font-size: 1.05rem;
    color: var(--muted);
    line-height: 1.5;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.75rem;
    text-wrap: pretty;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--muted);
  }

  .related-project {
    margin-top: 4rem;
    padding: 2rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }

  .related-project h3 {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .rp-name {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .rp-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .rp-links {
    display: flex;
    gap: 1rem;
  }

  .rp-links a {
    font-size: 0.85rem;
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .rp-links a:hover {
    border-bottom-color: var(--text-primary);
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .post-nav-link {
    display: block;
    max-width: 45%;
    text-decoration: none;
  }

  .post-nav-link.older {
    margin-left: auto;
    text-align: right;
  }

  .post-nav-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 0.35rem;
  }

  .post-nav-title {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-primary);
  }

  .post-nav-link:hover .post-nav-title {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .main {
      padding: 2rem 20px;
    }
    .article {
      max-width: none;
    }
    .article-title {
      font-size: 1.9rem;
    }
    .article-header {
      margin-bottom: 2rem;
    }
    .article-desc {
      font-size: 1rem;
      padding-bottom: 1.25rem;
      margin-bottom: 1.25rem;
    }
  }
</style>
